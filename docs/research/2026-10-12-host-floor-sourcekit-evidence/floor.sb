(version 1)
(allow default)
(deny file-read* file-read-data file-read-metadata (subpath "/private/var/folders/xx/yyyy/T/winter-host-floor-compat-UUTF2C/protected"))
(deny file-write* file-write-data file-write-mode file-write-owner file-write-unlink file-write-create (subpath "/private/var/folders/xx/yyyy/T/winter-host-floor-compat-UUTF2C/protected"))
(deny file-link (subpath "/private/var/folders/xx/yyyy/T/winter-host-floor-compat-UUTF2C/protected"))
(deny file-write-unlink file-write-create file-write-mode file-write-owner file-write-flags file-write-xattr (literal "/private/var/folders/xx/yyyy/T/winter-host-floor-compat-UUTF2C"))
(deny file-write-unlink file-write-create file-write-mode file-write-owner file-write-flags file-write-xattr (literal "/private/var/folders/xx/yyyy/T"))
(deny file-write-unlink file-write-create file-write-mode file-write-owner file-write-flags file-write-xattr (literal "/private/var/folders/xx/yyyy"))
(deny file-write-unlink file-write-create file-write-mode file-write-owner file-write-flags file-write-xattr (literal "/private/var/folders/xx"))
(deny file-write-unlink file-write-create file-write-mode file-write-owner file-write-flags file-write-xattr (literal "/private/var/folders"))
(deny file-write-unlink file-write-create file-write-mode file-write-owner file-write-flags file-write-xattr (literal "/private/var"))
(deny file-write-unlink file-write-create file-write-mode file-write-owner file-write-flags file-write-xattr (literal "/private"))
