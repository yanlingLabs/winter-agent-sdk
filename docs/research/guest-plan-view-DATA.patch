+# The plan view (contract revision 3, 12.5): the conversation's own epoch-scoped planning scratch, OUTSIDE .winter, at /workspace/plan/<logicalSessionId>/<epoch>
+# (epoch a canonical decimal, at most nine digits). It is the one root that is read-write under plan and it exists only under plan. PID 1 makes the directory
+# (root-side, no symlink); this service only admits it, and never admits an epoch below one that already exists beside it: an earlier epoch is never mounted again.
+PLAN_ROOT='/workspace/plan'
+PLAN_VIEW=re.compile(r'/workspace/plan/([A-Za-z0-9][A-Za-z0-9_.-]{0,127})/(0|[1-9][0-9]{0,8})')
+def plan_view_epoch(guest_path,sid):
+    match=PLAN_VIEW.fullmatch(guest_path) if type(guest_path) is str else None
+    return int(match.group(2)) if match and match.group(1)==sid else None
+def is_plan_view(guest_path):
+    return type(guest_path) is str and PLAN_VIEW.fullmatch(guest_path) is not None
+def plan_view_stale(sid,epoch):
+    # The data disk is the record of the epochs ever made for this conversation: any canonical sibling above this epoch makes this one stale. The parent is opened
+    # without following a symlink and must be a directory; a parent that cannot be read refuses (fail closed), never admits.
+    try:
+        fd=os.open(f'{PLAN_ROOT}/{sid}',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
+        try:names=os.listdir(fd)
