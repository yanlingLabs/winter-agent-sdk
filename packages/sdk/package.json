{
  "name": "@yanlinglabs/winter-agent-sdk",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "winter": {
    "publish": {
      "npm": true
    }
  },
  "dependencies": {
    "@yanlinglabs/winter-provider-catalog": "workspace:*"
  },
  "optionalDependencies": {
    "@yanlinglabs/winter-agent-sdk-darwin-arm64": "workspace:*"
  },
  "devDependencies": {
    "winter-agent-runtime": "workspace:*",
    "@yanlinglabs/winter-conformance": "workspace:*",
    "@types/node": "^26.4.0"
  },
  "types": "./dist/index.d.ts"
}
