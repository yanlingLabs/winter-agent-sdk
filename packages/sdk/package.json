{
  "name": "@yanlinglabs/winter-agent-sdk",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanlingLabs/winter-agent-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/yanlingLabs/winter-agent-sdk",
  "bugs": {
    "url": "https://github.com/yanlingLabs/winter-agent-sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "winter": {
    "publish": {
      "npm": true
    }
  },
  "dependencies": {
    "@yanlinglabs/winter-provider-catalog": "workspace:*"
  },
  "optionalDependencies": {
    "@yanlinglabs/winter-agent-sdk-darwin-arm64": "workspace:*"
  },
  "devDependencies": {
    "winter-agent-runtime": "workspace:*",
    "@yanlinglabs/winter-conformance": "workspace:*",
    "@types/node": "^26.4.0"
  }
}
