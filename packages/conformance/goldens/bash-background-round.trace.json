[
  {
    "sequence": 0,
    "direction": "runtime-to-host",
    "kind": "system/init",
    "payload": {
      "type": "system",
      "subtype": "init",
      "cwd": "/winter-fixture",
      "model": "sonnet",
      "permissionMode": "default",
      "tools": [
        "Agent",
        "AskUserQuestion",
        "Bash",
        "CronCreate",
        "CronDelete",
        "CronList",
        "Edit",
        "EnterPlanMode",
        "EnterWorktree",
        "ExitPlanMode",
        "ExitWorktree",
        "Glob",
        "Grep",
        "ListAgents",
        "Monitor",
        "NotebookEdit",
        "PushNotification",
        "Read",
        "ReadNotifications",
        "ReportFindings",
        "ScheduleWakeup",
        "SendMessage",
        "Skill",
        "TaskCreate",
        "TaskGet",
        "TaskList",
        "TaskOutput",
        "TaskStop",
        "TaskUpdate",
        "Workflow",
        "Write"
      ],
      "slash_commands": [
        "compact"
      ],
      "output_style": "default",
      "skills": [],
      "plugins": []
    }
  },
  {
    "sequence": 1,
    "direction": "runtime-to-host",
    "kind": "assistant",
    "payload": {
      "type": "assistant",
      "message": {
        "content": [
          {
            "type": "tool_use",
            "id": "bash-bg-call-1",
            "name": "Bash",
            "input": {
              "command": "sleep 10",
              "run_in_background": true
            }
          }
        ]
      }
    }
  },
  {
    "sequence": 2,
    "direction": "runtime-to-host",
    "kind": "system/task_started",
    "payload": {
      "type": "system",
      "subtype": "task_started",
      "task_id": "TASKID",
      "description": "sleep 10",
      "is_backgrounded": true
    }
  },
  {
    "sequence": 3,
    "direction": "runtime-to-host",
    "kind": "system/background_tasks_changed",
    "payload": {
      "type": "system",
      "subtype": "background_tasks_changed",
      "tasks": [
        {
          "task_id": "TASKID",
          "task_type": "bash",
          "description": "sleep 10"
        }
      ]
    }
  },
  {
    "sequence": 4,
    "direction": "runtime-to-host",
    "kind": "user",
    "payload": {
      "type": "user",
      "message": {
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "bash-bg-call-1",
            "content": "background task TASKID started\noutput_file: /winter-fixture-tasks/TASKID.output\n[sandbox: config-disabled]\nRead or grep that file for output as it accumulates; use task_output to peek, task_stop to stop it."
          }
        ]
      }
    }
  },
  {
    "sequence": 5,
    "direction": "runtime-to-host",
    "kind": "assistant",
    "payload": {
      "type": "assistant",
      "message": {
        "content": [
          {
            "type": "text",
            "text": "backgrounded"
          }
        ]
      }
    }
  },
  {
    "sequence": 6,
    "direction": "runtime-to-host",
    "kind": "result",
    "payload": {
      "type": "result",
      "subtype": "success",
      "is_error": false,
      "result": "backgrounded",
      "permission_denials": []
    }
  }
]
