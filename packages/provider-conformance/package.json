{
  "name": "@yanlinglabs/winter-provider-conformance",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./fakes": {
      "types": "./dist/fakes/index.d.ts",
      "bun": "./src/fakes/index.ts",
      "default": "./dist/fakes/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "winter": {
    "publish": {
      "npm": false
    }
  },
  "dependencies": {
    "@yanlinglabs/winter-provider-catalog": "workspace:*",
    "@yanlinglabs/winter-provider-runtime": "workspace:*"
  },
  "types": "./dist/index.d.ts"
}
