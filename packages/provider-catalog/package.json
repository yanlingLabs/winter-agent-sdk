{
  "name": "@yanlinglabs/winter-provider-catalog",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./families": "./src/families.ts"
  },
  "files": [
    "src",
    "generated",
    "overlay",
    "schema",
    "NOTICE",
    "PROVENANCE.md",
    "UPSTREAM.json",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
