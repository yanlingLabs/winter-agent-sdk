{
  "name": "@yanlinglabs/winter-provider-catalog",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./families": {
      "types": "./dist/families.d.ts",
      "bun": "./src/families.ts",
      "default": "./dist/families.js"
    }
  },
  "files": [
    "dist",
    "src",
    "generated",
    "overlay",
    "schema",
    "NOTICE",
    "PROVENANCE.md",
    "UPSTREAM.json",
    "!src/**/*.test.ts",
    "!src/**/*.test-support.ts"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "winter": {
    "publish": {
      "npm": true
    }
  },
  "types": "./dist/index.d.ts"
}
